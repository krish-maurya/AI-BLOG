generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// model decleration

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String   // This will be the author name
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model Blog {
  id          String    @id @default(uuid())
  title       String
  subTitle    String
  description String
  category    String
  image       String
  author      String
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]
}

model Comment {
  id         String   @id @default(uuid())
  blogId     String
  name       String
  content    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  blog       Blog     @relation(fields: [blogId], references: [id])
}
